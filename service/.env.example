# Garmin credentials (NEVER commit these — fill in on the host)
GARMIN_EMAIL=your.email@example.com
GARMIN_PASSWORD=your-password

# Shared API key — generate a random one, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# This key is safe for the client to have — it grants access to
# health DATA only, never to your Garmin credentials.
GARMIN_SYNC_API_KEY=generate-a-random-key-here

# Optional: restrict which data types are exposed (default: all)
# Comma-separated. Available types:
#   summary, body_composition, sleep, activities, hrv,
#   training_readiness, stress, heart_rates, respiration,
#   spo2, hydration, body_battery, max_metrics, training_status
# Example: only calories + sleep + workouts
# GARMIN_DATA_TYPES=summary,sleep,activities
